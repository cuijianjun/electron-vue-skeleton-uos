{
  "name": "electron-vue-skeleton",
  "version": "1.0.0",
  "author": "your-name <your-email@example.com>",
  "description": "Electron + Vue 3 + Vite desktop skeleton (UOS; target machine acceptance pending)",
  "license": "MIT",
  "main": "dist/electron/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build:app": "electron-vite build",
    "build": "npm run build:linux:arm64",
    "build:prod": "npm run build:linux:arm64",
    "build:test": "electron-vite build --mode test",
    "build:dir": "electron-vite build && electron-builder --dir --publish never",
    "build:clean": "node scripts/clean.cjs",
    "pack:resources": "node scripts/pack-resources.cjs",
    "update:serve": "node server/index.js",
    "test:unit": "node --test test/unit/*.test.cjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.cjs",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "test:dev": "node --test test/e2e/hmr.cjs",
    "build:linux": "node scripts/build.cjs --platform linux",
    "build:linux:arm64": "node scripts/build.cjs --platform linux --arch arm64",
    "build:linux:x64": "node scripts/build.cjs --platform linux --arch x64",
    "test:packaged": "node --test test/e2e/packaged.cjs",
    "start": "electron-vite preview"
  },
  "build": {
    "asar": false,
    "compression": "store",
    "productName": "myapp",
    "appId": "com.example.myapp",
    "executableName": "myapp",
    "protocols": [
      {
        "name": "myapp",
        "schemes": [
          "myapp"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.invalid/",
        "channel": "latest"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "static/",
        "to": "static/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "build/shell/512x512.png",
      "category": "Utility",
      "asarUnpack": [
        "**/*.{node,dll}",
        "**/lib*.so*"
      ],
      "desktop": {
        "entry": {
          "Name": "myapp",
          "Comment": "我的应用",
          "GenericName": "My App",
          "Keywords": "app;uos;deepin;",
          "StartupNotify": "true",
          "Terminal": "false",
          "Icon": "myapp",
          "Categories": "Utility;",
          "MimeType": "x-scheme-handler/myapp;",
          "StartupWMClass": "myapp",
          "X-Deepin-CreatedBy": "com.deepin.dde.daemon",
          "X-Deepin-AppID": "myapp",
          "X-UOS-AppID": "myapp"
        }
      },
      "syncDesktopName": true
    },
    "extraFiles": [
      {
        "from": "build/shell",
        "to": "build/shell"
      }
    ],
    "deb": {
      "compression": "xz",
      "fpm": [
        "--deb-no-default-config-files",
        "--deb-compression=xz"
      ],
      "afterInstall": "./build/shell/postinst.sh",
      "afterRemove": "./build/shell/prerm.sh",
      "priority": "optional",
      "synopsis": "我的应用"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "axios": "^1.4.0",
    "builder-util-runtime": "9.7.0",
    "electron-log": "^5.4.0",
    "electron-store": "8.0.1",
    "electron-updater": "6.8.11",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/compiler-sfc": "3.5.45",
    "autoprefixer": "10.6.2",
    "dotenv": "16.6.1",
    "electron": "44.7.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "express": "4.22.2",
    "playwright": "1.65.0",
    "sass": "1.100.0",
    "vite": "8.3.8",
    "vue": "3.5.45",
    "vue-router": "4.6.4",
    "vuex": "4.1.0"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "homepage": "https://electron-vite.org",
  "desktopName": "myapp.desktop"
}
